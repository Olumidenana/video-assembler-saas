# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=           # Shown on /privacy and /terms

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # "Publishable" key (or the legacy anon key)
SUPABASE_SECRET_KEY=                    # "Secret" key (or legacy service_role). Server only, never NEXT_PUBLIC_

# Paystack → Settings → API Keys & Webhooks (use test keys until launch)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx          # Server only
PAYSTACK_PLAN_CODE=PLN_xxx               # Pro plan (Paystack → Plans, monthly, NGN)
PAYSTACK_STUDIO_PLAN_CODE=PLN_yyy        # Studio plan

# Anthropic (console.anthropic.com -> API Keys). Powers the editor's free-text AI commands.
# Optional: without it, auto-edit and common commands still work in the browser.
ANTHROPIC_API_KEY=                     # Server only

# Emails that get Studio free (owner, testers), comma-separated. Server-only: set as a Secret in Vercel.
COMPLIMENTARY_STUDIO_EMAILS=

# YouTube posting (Studio): Google Cloud Console -> APIs & Services.
# 1. Enable "YouTube Data API v3". 2. OAuth consent screen: add the scopes youtube.upload and
# youtube.readonly. 3. Credentials -> OAuth client (Web): add the redirect URI
#    <NEXT_PUBLIC_SITE_URL>/api/youtube/callback
# Can be the same client as Google sign-in. Both server-only: set as Secrets in Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Content Posting API (Studio): developers.tiktok.com
# 1. Register a developer account and create an app in the TikTok Developer Portal.
# 2. Add products: "Login Kit" and "Content Posting API".
# 3. Add redirect URI:
#    <NEXT_PUBLIC_SITE_URL>/api/tiktok/callback
# 4. Add sandbox test users under App Details -> Test Users while in sandbox mode.
# 5. Scopes used: user.info.basic, video.upload (plus video.publish if direct posting is enabled).
# 6. Set TIKTOK_DIRECT_POST=1 only after passing TikTok's app audit; defaults to inbox upload.
# Server-only: set as Secrets in Vercel. Requires migration 0005_tiktok.sql.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DIRECT_POST=0
