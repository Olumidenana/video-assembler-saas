# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # "Publishable" key (or the legacy anon key)
SUPABASE_SECRET_KEY=                    # "Secret" key (or legacy service_role). Server only, never NEXT_PUBLIC_

# Paystack → Settings → API Keys & Webhooks (use test keys until launch)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx          # Server only
PAYSTACK_PLAN_CODE=PLN_xxx               # Paystack → Products → Plans (monthly, NGN)
